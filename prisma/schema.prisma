generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  SALES
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BuyingMode {
  DIRECT
  REQUEST_PRICE
  CHECK_AVAILABILITY
  ASSISTED
  DIRECT_AND_ASSISTED
}

enum StockStatus {
  AVAILABLE
  LOW_STOCK
  OUT_OF_STOCK
  RESERVED
  COMING_SOON
  BY_REQUEST
}

enum Currency {
  COP
  USD
  EUR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  WOMPI
  MANUAL
}

enum PaymentMethod {
  CARD
  PSE
  NEQUI
  DAVIPLATA
  BANCOLOMBIA
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  LOST
}

enum LeadSource {
  WHATSAPP
  WEB
}

enum WebhookEventType {
  LEAD_CREATED
  ORDER_CREATED
  ORDER_PAID
  ORDER_CANCELLED
  CART_ABANDONED
  WHATSAPP_CONSULTATION
  CUSTOMER_CREATED
  PRODUCT_OUT_OF_STOCK
  PRODUCT_LOW_STOCK
}

enum WebhookStatus {
  PENDING
  DELIVERED
  FAILED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

// ============================================================
// AUTHENTICATION (Auth.js v5 — Prisma Adapter)
// ============================================================

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role           @default(EDITOR)
  active        Boolean        @default(true)
  customer      Customer?
  accounts      Account[]
  sessions      Session[]
  permissions   UserPermission[]
  leadsAssigned Lead[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// RBAC
// ============================================================

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  users       UserPermission[]
  createdAt   DateTime         @default(now())
}

model UserPermission {
  userId       String
  permissionId String
  grantedBy    String?
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
}

// ============================================================
// CATALOG
// ============================================================

model Category {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]  @relation("CategoryTree")
  sortOrder   Int         @default(0)
  active      Boolean     @default(true)
  products    Product[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Collection {
  id          String               @id @default(cuid())
  slug        String               @unique
  name        String
  description String?
  imageUrl    String?
  sortOrder   Int                  @default(0)
  active      Boolean              @default(true)
  exclusive   Boolean              @default(false)
  products    ProductCollection[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  @@id([productId, collectionId])
  @@index([collectionId])
}

model Product {
  id               String          @id @default(cuid())
  slug             String          @unique
  sku              String          @unique
  name             String
  shortDescription String?
  description      String?
  price            Int?
  compareAtPrice   Int?
  currency         Currency        @default(COP)
  costPrice        Int?
  material         String?
  goldType         String?
  stone            String?
  stoneColor       String?
  stoneCarat       String?
  weight           String?
  dimensions       String?
  certification    String?
  certificateUrl   String?
  isGemCertified   Boolean         @default(false)
  careInstructions String?
  buyingMode       BuyingMode      @default(DIRECT)
  isCustomizable   Boolean         @default(false)
  featured         Boolean         @default(false)
  exclusive        Boolean         @default(false)
  isDemo           Boolean         @default(false)
  status           ProductStatus   @default(DRAFT)
  highValue        Boolean         @default(false)
  viewCount        Int             @default(0)
  soldCount        Int             @default(0)
  categoryId       String?
  category         Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  collections      ProductCollection[]
  images           ProductImage[]
  videos           ProductVideo[]
  inventory        Inventory?
  wishlists        Wishlist[]
  reviews          Review[]
  orderItems       OrderItem[]
  leads            Lead[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([featured])
}

// ============================================================
// MEDIA
// ============================================================

model MediaAsset {
  id            String         @id @default(cuid())
  type          MediaType      @default(IMAGE)
  originalUrl   String
  thumbnailUrl  String?
  mediumUrl     String?
  largeUrl      String?
  fileName      String
  mimeType      String
  sizeBytes     Int
  width         Int?
  height        Int?
  alt           String?
  caption       String?
  uploadedBy    String?
  productImages ProductImage[]
  productVideos ProductVideo[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model ProductImage {
  id        String     @id @default(cuid())
  productId String
  assetId   String
  sortOrder Int        @default(0)
  isPrimary Boolean    @default(false)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVideo {
  id        String     @id @default(cuid())
  productId String
  assetId   String
  sortOrder Int        @default(0)
  isPrimary Boolean    @default(false)
  posterUrl String?
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ============================================================
// INVENTORY
// ============================================================

model Inventory {
  id            String      @id @default(cuid())
  productId     String      @unique
  stock         Int         @default(0)
  minStock      Int         @default(0)
  reservedStock Int         @default(0)
  track         Boolean     @default(true)
  strict        Boolean     @default(false)
  status        StockStatus @default(BY_REQUEST)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedAt     DateTime    @updatedAt
}

// ============================================================
// SEO
// ============================================================

enum SeoEntityType {
  PRODUCT
  CATEGORY
  COLLECTION
  PAGE
}

model SeoData {
  id            String        @id @default(cuid())
  entityType    SeoEntityType
  entityId      String
  title         String?
  description   String?
  keywords      String[]      @default([])
  canonical     String?
  ogTitle       String?
  ogDescription String?
  ogImage       String?
  robots        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType])
}

// ============================================================
// CUSTOMERS & ADDRESSES
// ============================================================

model Customer {
  id             String     @id @default(cuid())
  email          String?
  firstName      String?
  lastName       String?
  phone          String?
  marketingOptIn Boolean    @default(false)
  notes          String?
  userId         String?    @unique
  user           User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders         Order[]
  addresses      Address[]
  wishlists      Wishlist[]
  reviews        Review[]
  leads          Lead[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Address {
  id         String    @id @default(cuid())
  customerId String?
  firstName  String
  lastName   String
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String?
  country    String    @default("CO")
  phone      String?
  isDefault  Boolean   @default(false)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orders     Order[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([customerId])
}

// ============================================================
// ORDERS & PAYMENTS
// ============================================================

model Order {
  id                 String        @id @default(cuid())
  number             String        @unique
  customerId         String?
  customerEmail      String
  customerPhone      String?
  billingName        String
  shippingAddressId  String?
  shippingAddress    Address?      @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  shippingName       String
  shippingLine1      String
  shippingLine2      String?
  shippingCity       String
  shippingRegion     String?
  shippingPostalCode String?
  shippingCountry    String        @default("CO")
  itemsTotal         Int
  shippingFee        Int           @default(0)
  discountAmount     Int           @default(0)
  taxAmount          Int           @default(0)
  total              Int
  currency           Currency      @default(COP)
  status             OrderStatus   @default(PENDING)
  paymentStatus      PaymentStatus @default(PENDING)
  source             String?
  notes              String?
  adminNotes         String?
  ipCountry          String?
  metadata           Json?
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  payments           Payment[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  name      String
  sku       String
  quantity  Int
  unitPrice Int
  total     Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider @default(WOMPI)
  providerReference String?         @unique
  amount            Int
  currency          Currency        @default(COP)
  status            PaymentStatus   @default(PENDING)
  method            PaymentMethod?
  failureReason     String?
  payload           Json?
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([orderId])
  @@index([providerReference])
}

// ============================================================
// PROMOTIONS
// ============================================================

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  value         Int
  minOrderValue Int?
  maxUses       Int?
  usedCount     Int        @default(0)
  active        Boolean    @default(true)
  startsAt      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

// ============================================================
// WISHLIST & REVIEWS
// ============================================================

model Wishlist {
  id         String    @id @default(cuid())
  customerId String?
  sessionId  String?
  productId  String
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([customerId, productId])
  @@index([sessionId])
  @@index([productId])
}

model Review {
  id           String    @id @default(cuid())
  productId    String
  customerId   String?
  customerName String?
  rating       Int
  title        String?
  body         String?
  verified     Boolean   @default(false)
  active       Boolean   @default(true)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([productId])
}

// ============================================================
// LEADS (WhatsApp / asesoría)
// ============================================================

model Lead {
  id           String     @id @default(cuid())
  source       LeadSource @default(WEB)
  status       LeadStatus @default(NEW)
  productId    String?
  customerId   String?
  name         String?
  email        String?
  phone        String?
  message      String?
  metadata     Json?
  assignedToId String?
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo   User?      @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@index([productId])
  @@index([assignedToId])
}

// ============================================================
// CONTENT
// ============================================================

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  city      String?
  text      String
  rating    Int      @default(5)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  source       String?  @default("home")
  subscribedAt DateTime @default(now())
  active       Boolean  @default(true)
}

model SitePage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   @db.Text
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

// ============================================================
// INTEGRATIONS
// ============================================================

model WebhookEvent {
  id             String          @id @default(cuid())
  eventType      WebhookEventType
  payload        Json
  status         WebhookStatus   @default(PENDING)
  attempts       Int             @default(0)
  lastError      String?
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  responseStatus Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([eventType])
  @@index([status])
}

// ============================================================
// SETTINGS (singleton por clave)
// ============================================================

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}