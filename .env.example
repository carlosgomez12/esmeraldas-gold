# ============================================================
# ESMERALDAS GOLD — Variables de entorno
# Copia este archivo a `.env` y completa los valores reales.
# NUNCA subas `.env` al repositorio.
# ============================================================

# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/esmeraldas_gold?schema=public"

# --- Autenticación (Auth.js v5) ---
# Genera con: openssl rand -base64 32  (o: npx auth secret)
AUTH_SECRET="genera-un-secreto-de-32-bytes"
AUTH_TRUST_HOST="true"

# --- Sitio ---
# Dominio final cuando exista. Sin '/' final. Ej: https://www.esmeraldasgold.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Esmeraldas Gold"
NEXT_PUBLIC_SITE_LANG="es"

# --- WhatsApp comercial (número en formato internacional sin "+") ---
NEXT_PUBLIC_WHATSAPP_NUMBER="573001234567"
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE="Hola, me gustaría recibir asesoría sobre sus joyas."

# --- Pagos (Wompi) ---
WOMPI_PUBLIC_KEY="pub_test_..."
WOMPI_PRIVATE_KEY="prv_test_..."
WOMPI_EVENTS_SECRET="YOUR_WOMPI_EVENTS_SECRET"
WOMPI_CURRENCY="COP"
WOMPI_WEBHOOK_PATH="/api/webhooks/wompi"

# --- N8N / automatizaciones ---
# Deja vacío para desactivar. URL del endpoint de n8n (p.ej. webhook de n8n)
N8N_WEBHOOK_URL=""
# Secreto compartido para firmar los eventos (HMAC). Debe coincidir en n8n.
N8N_WEBHOOK_SECRET="n8n-shared-secret"

# --- Airbnb / CRM futuro ---
CRM_WEBHOOK_URL=""
CRM_WEBHOOK_SECRET=""

# --- Analytics ---
# (Google Tag Manager container ID, ej: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=""
# (Google Analytics 4 measurement ID, ej: G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GA4_ENABLED="false"

# --- Email transaccional (borrador — Resend u otro proveedor SMTP) ---
EMAIL_PROVIDER="resend"
EMAIL_FROM="Esmeraldas Gold <hola@esmeraldasgold.com>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# --- Media / almacenamiento ---
# "local" (MVP) | "s3-compatible" (futuro)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="public/media"
STORAGE_PUBLIC_URL="/media"

# --- Administrador inicial (usado por el seed) ---
SEED_ADMIN_EMAIL="admin@esmeraldasgold.com"
SEED_ADMIN_PASSWORD="cambia-esta-password"

# --- Umbral de producto de alto valor (COP, centavos) ---
HIGH_VALUE_THRESHOLD_COP="30000000"

# --- Configuración del sitio (puede gestionarse desde el panel) ---
SITE_DEFAULT_CURRENCY="COP"
SITE_LOCALE="es-CO"

# --- Testing ---
# URL base para E2E (Playwright)
PLAYWRIGHT_BASE_URL="http://localhost:3000"

# --- Misc ---
NODE_ENV="development"